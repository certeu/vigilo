FROM python:3.13-slim
WORKDIR /app
# git: needed to clone GitLab repositories during ingestion.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY src ./src
COPY scripts ./scripts
RUN pip install --no-cache-dir -e ".[webapi]"
EXPOSE 8080
CMD ["python", "-m", "src.webapi.main"]
