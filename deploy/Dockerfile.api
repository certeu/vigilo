FROM python:3.13-slim
WORKDIR /app
# git: needed to clone GitLab repositories during ingestion.
# bubblewrap: OS isolation for agent-written analysis tools (grey-box sandbox,
# VIGILO_GREYBOX_SANDBOX_ISOLATION). It needs user namespaces at run time; see
# deploy/config-reference.md.
# libatomic1: required by the Node binary bundled with Playwright on arm64 hosts
# (the browser layer below fails with "libatomic.so.1: cannot open" without it).
RUN apt-get update && apt-get install -y --no-install-recommends git bubblewrap util-linux libatomic1 \
    && rm -rf /var/lib/apt/lists/*
# Report export fonts (DOCX/PDF): DejaVu Sans for body text + DejaVu Sans Mono
# for code blocks, rendered by src/webapi/report_export.py. Debian splits the
# faces across packages: core = Sans/Bold/Oblique, mono = SansMono (the extra
# flags/emoji package is not needed). Version is pinned so an image rebuild
# cannot silently change the glyphs the PDF exports.
ARG DEJAVU_VERSION=2.37-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      "fonts-dejavu-core=${DEJAVU_VERSION}" "fonts-dejavu-mono=${DEJAVU_VERSION}" \
    && test -f /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    && test -f /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY src ./src
COPY scripts ./scripts
RUN pip install --no-cache-dir -e ".[webapi]"
# The grey-box browser capability (Playwright + headless Chromium and its system
# libraries). Build with --build-arg GREYBOX_BROWSER=0 to leave it out: the
# capability is then reported unavailable and never offered to the agent.
ARG GREYBOX_BROWSER=1
RUN if [ "$GREYBOX_BROWSER" = "1" ]; then \
      pip install --no-cache-dir -e ".[webapi,browser]" && \
      python -m playwright install --with-deps chromium-headless-shell && \
      rm -rf /var/lib/apt/lists/*; \
    fi
EXPOSE 8080
CMD ["python", "-m", "src.webapi.main"]
