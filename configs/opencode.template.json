{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "*": "allow"
  },

  "enabled_providers": ["litellm"],

  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "${LITELLM_BASE_URL}",
        "apiKey": "${LITELLM_API_KEY}"
      },
      "models": __MODELS__
    }
  },

  "small_model": "litellm/${OPENCODE_SMALL_MODEL}",

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  }
}
