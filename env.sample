# ============================================================================
# Vigilo configuration.  Copy to .env:   cp env.sample .env
# ============================================================================
# Pick ONE LLM backend. VIGILO_EXECUTOR selects it
#   claude   -> Claude Code CLI  (Anthropic API / AWS Bedrock / Azure Foundry)
#   codex    -> OpenAI Codex CLI (OpenAI / Azure Foundry / LiteLLM)
#   opencode -> OpenCode CLI     (local / self-hosted via LiteLLM)
# VIGILO_EXECUTOR=claude

# --- Backend A: Anthropic API (default) -------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional per-tier overrides (defaults: haiku / sonnet / opus):
# ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_MEDIUM_MODEL=claude-sonnet-4-6
# ANTHROPIC_LARGE_MODEL=claude-opus-4-7

# --- Backend A2: Claude via AWS Bedrock (instead of ANTHROPIC_API_KEY) -------
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=eu-west-1
# AWS_BEARER_TOKEN_BEDROCK=...        # simplest; or use the key pair / profile:
# ANTHROPIC_MODEL=eu.anthropic.claude-opus-4-7

# --- Backend A3: Claude via Azure Foundry (instead of ANTHROPIC_API_KEY) -----
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=<resource-name>
# ANTHROPIC_FOUNDRY_API_KEY=...

# --- Backend B: OpenAI Codex CLI (OpenAI / Azure Foundry / LiteLLM) ----------
# VIGILO_EXECUTOR=codex
# CODEX_BASE_URL=https://api.openai.com/v1                            # OpenAI direct
# CODEX_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1   # Azure Foundry (MUST end in /v1)
# CODEX_API_KEY=sk-...
# CODEX_WIRE_API=responses            # responses (OpenAI/Azure v1) | chat (classic)
# CODEX_REASONING_EFFORT=medium       # low | medium | high
# CODEX_SMALL_MODEL=gpt-5-mini
# CODEX_MEDIUM_MODEL=gpt-5-codex
# CODEX_LARGE_MODEL=gpt-5-codex
# CODEX_PRICE_INPUT_PER_MTOK=1.25     # optional; Codex reports no cost -> estimated
# CODEX_PRICE_OUTPUT_PER_MTOK=10
# CODEX_EXTRA_CA_CERT=/certs/internal-ca.crt   # internal CA (Codex uses the system trust store)
# CODEX_IDLE_LOG_INTERVAL_S=30        # log "waiting on model" every N s of silence
# Already have generic OPENAI_* vars? Set only VIGILO_EXECUTOR=codex; entrypoint maps them:
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-codex

# --- Backend C: OpenCode via LiteLLM (local / self-hosted models) -----------
# VIGILO_EXECUTOR=opencode
# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_API_KEY=...
# OPENCODE_SMALL_MODEL=qwen3.6
# OPENCODE_MEDIUM_MODEL=qwen3.6
# OPENCODE_LARGE_MODEL=qwen3.6

# --- Corporate proxy (optional) -------------------
# NO_PROXY MUST include `temporal` so worker<->Temporal gRPC skips the proxy.
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=temporal,localhost,127.0.0.1,0.0.0.0,host.docker.internal,.internal

# --- GitLab integration (optional; enables PUSH=1 + MR creation) ------------
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=glpat-...
# GIT_PUSH_USER=oauth2
# VIGILO_PUSH_BRANCHES=1

# --- Grey-box pipeline (optional) -------------------------------------------
# SURREALDB_URL=ws://surrealdb:8000
# SURREALDB_USER=root
# SURREALDB_PASS=changeme
# SURREALDB_HOST_PORT=8010   # host port mapped to container :8000; change if in use
# GREYBOX_MAX_CONCURRENT_AGENTS=12
# GREYBOX_PER_SCAN_COST_CEILING=50.00

# --- Web platform: API + UI (docker-compose.full.yml) -----------------------
# Required secrets (export in your shell or put in this .env before `up`):
# VIGILO_JWT_SECRET=change-me-to-a-long-random-string   # signs login tokens
# VIGILO_FERNET_KEY=...   # encrypts stored per-user credentials; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# POSTGRES_PASSWORD=changeme
# First admin is created on first start (leave blank to skip auto-creation):
# VIGILO_FIRST_ADMIN_EMAIL=admin@example.com
# VIGILO_FIRST_ADMIN_PASSWORD=change-me-now
# Public URL of the UI, used in email links (invites, run-complete):
# VIGILO_UI_BASE_URL=http://localhost:8081

# --- Email notifications (run reports + user invitations) -------------------
# Unset VIGILO_SMTP_HOST -> notifications are silently disabled (no-op mailer).
#
# DEV default: the bundled MailHog catches every message (no auth, no TLS).
#   Open the caught mail at  http://localhost:8025
#   docker-compose.full.yml already points the API at it:
# VIGILO_SMTP_HOST=mailhog
# VIGILO_SMTP_PORT=1025
# VIGILO_SMTP_FROM=vigilo@example.com
#
# PRODUCTION: point at a real relay; add USER/PASSWORD for authenticated SMTP
# (LOGIN) and STARTTLS to upgrade the connection (typical on port 587).
# VIGILO_SMTP_HOST=smtp.example.com
# VIGILO_SMTP_PORT=587
# VIGILO_SMTP_FROM=vigilo@example.com
# VIGILO_SMTP_USER=vigilo
# VIGILO_SMTP_PASSWORD=...
# VIGILO_SMTP_STARTTLS=true

# --- Platform runtime knobs (optional; sensible defaults in compose) --------
# VIGILO_EXECUTION_ENGINE=temporal          # temporal | docker | mock
# VIGILO_GLOBAL_CONCURRENT_RUN_CAP=2        # max pipelines running at once

# --- Production TLS deployment (docker-compose.full.yml + Traefik) -----------
# Traefik terminates TLS and is the ONLY service with published ports (80 -> 443
# redirect, 443). The UI is the sole public router; API / Postgres / Temporal /
# MailHog stay internal on the Docker network (the UI's nginx proxies /api).
# Public UI hostname — REQUIRED to bring up the full stack:
# VIGILO_HOSTNAME=vigilo.example.com
#
# Certificates are issued over ACME (HTTP-01 challenge on :80, so the CA must
# reach this host on port 80 at VIGILO_HOSTNAME).
# ACME_EMAIL must be a REAL address — Let's Encrypt rejects @example.com.
# ACME_EMAIL=you@your-domain.example
# ACME_CASERVER defaults to Let's Encrypt. Set it only to use another CA, e.g.
# an internal/corporate ACME server:
# ACME_CASERVER=https://acme.your-internal-ca.example/acme/directory
#
# Email links default to https://$VIGILO_HOSTNAME; override if needed:
# VIGILO_UI_BASE_URL=https://vigilo.example.com

# --- Running WITHOUT Traefik / without TLS ----------------------------------
# Traefik is optional. Layer deploy/docker-compose.plain.yml on top of the full
# stack to skip it and publish the UI directly on a host port instead:
#   docker compose --env-file .env -f deploy/docker-compose.full.yml \
#       -f deploy/docker-compose.plain.yml up --build -d
# VIGILO_HTTP_PORT=8080            # UI at http://localhost:8080
# VIGILO_HTTP_PORT=127.0.0.1:8080  # loopback only — use when your own proxy fronts it
# Terminating TLS in your own proxy? Also set VIGILO_UI_BASE_URL above to the
# public URL, or email links will point at the wrong address.
# See "Deployment options" in the README.
