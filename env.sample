# ============================================================================
# Vigilo configuration.  Copy to .env:   cp env.sample .env
# ============================================================================
# Pick ONE LLM backend. VIGILO_EXECUTOR selects it
#   claude   -> Claude Code CLI  (Anthropic API / AWS Bedrock / Azure Foundry)
#   codex    -> OpenAI Codex CLI (OpenAI / Azure Foundry / LiteLLM)
#   opencode -> OpenCode CLI     (local / self-hosted via LiteLLM)
# VIGILO_EXECUTOR=claude

# --- Backend A: Anthropic API (default) -------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional per-tier overrides (defaults: haiku / sonnet / opus):
# ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_MEDIUM_MODEL=claude-sonnet-4-6
# ANTHROPIC_LARGE_MODEL=claude-opus-4-7

# --- Backend A2: Claude via AWS Bedrock (instead of ANTHROPIC_API_KEY) -------
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=eu-west-1
# AWS_BEARER_TOKEN_BEDROCK=...        # simplest; or use the key pair / profile:
# ANTHROPIC_MODEL=eu.anthropic.claude-opus-4-7

# --- Backend A3: Claude via Azure Foundry (instead of ANTHROPIC_API_KEY) -----
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=<resource-name>
# ANTHROPIC_FOUNDRY_API_KEY=...

# --- Backend B: OpenAI Codex CLI (OpenAI / Azure Foundry / LiteLLM) ----------
# VIGILO_EXECUTOR=codex
# CODEX_BASE_URL=https://api.openai.com/v1                            # OpenAI direct
# CODEX_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1   # Azure Foundry (MUST end in /v1)
# CODEX_API_KEY=sk-...
# CODEX_WIRE_API=responses            # responses (OpenAI/Azure v1) | chat (classic)
# CODEX_REASONING_EFFORT=medium       # low | medium | high
# CODEX_SMALL_MODEL=gpt-5-mini
# CODEX_MEDIUM_MODEL=gpt-5-codex
# CODEX_LARGE_MODEL=gpt-5-codex
# CODEX_PRICE_INPUT_PER_MTOK=1.25     # optional; Codex reports no cost -> estimated
# CODEX_PRICE_OUTPUT_PER_MTOK=10
# CODEX_EXTRA_CA_CERT=/certs/internal-ca.crt   # internal CA (Codex uses the system trust store)
# CODEX_IDLE_LOG_INTERVAL_S=30        # log "waiting on model" every N s of silence
# CODEX_TLS_BRIDGE=false              # true: route the Codex CLI through a loopback TLS bridge in the
#                                     # worker, for endpoints that drop the CLI's TLS handshake
#                                     # ("stream disconnected ... error sending request"); see README
# CODEX_TLS_BRIDGE_PORT=18443         # loopback port of that bridge
# Already have generic OPENAI_* vars? Set only VIGILO_EXECUTOR=codex; entrypoint maps them:
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-codex

# --- Backend C: OpenCode via LiteLLM (local / self-hosted models) -----------
# VIGILO_EXECUTOR=opencode
# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_API_KEY=...
# OPENCODE_SMALL_MODEL=qwen3.6
# OPENCODE_MEDIUM_MODEL=qwen3.6
# OPENCODE_LARGE_MODEL=qwen3.6

# --- Corporate proxy (optional) -------------------
# Used for model API calls (white-box CLIs and the grey-box agent) and the white-box
# engine's own traffic. NO_PROXY MUST list the internal service names: `temporal`
# (worker<->Temporal gRPC) and `postgres,api` (grey-box worker), else containers try
# to reach each other through the proxy.
# Grey-box traffic to TARGETS never reads these variables: for targets only reachable
# through a proxy see VIGILO_GREYBOX_EGRESS_PROXIES_ENABLED below.
# A proxy does not fix TLS handshake failures to the model endpoint (the handshake is
# end-to-end); see "Troubleshooting" in the README.
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=temporal,postgres,api,localhost,127.0.0.1,0.0.0.0,host.docker.internal,.internal

# --- GitLab patch push-back (optional) --------------------------------------
# No global token: pushing is configured per repository in the web UI. Attach the
# repo from GitLab with a credential and tick "push patches"; then, for that run
# only, Vigilo pushes each verified fix/* branch to the repo's origin and opens one
# merge request per fix. The token is decrypted by the API, written to a 0600 file
# in the run's data dir (outside the repo) and deleted when the run ends - it never
# enters workflow input, logs or the checkout. Without that setting (or for uploaded
# sources) nothing is pushed and the report lists the patches as available locally.
# The MR API base URL is derived from the repository's own remote.
# GITLAB_URL=                 # fallback only: GitLab served from a sub-path (https://host/gitlab)
# GIT_PUSH_USER=oauth2        # HTTP basic-auth user paired with the token

# --- Web platform: API + UI (docker-compose.full.yml) -----------------------
# Required secrets (export in your shell or put in this .env before `up`):
# VIGILO_JWT_SECRET=change-me-to-a-long-random-string   # signs login tokens
# VIGILO_FERNET_KEY=...   # encrypts stored per-user credentials; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# POSTGRES_PASSWORD=...   # required, no default: `docker compose` refuses to start without it
# The worker container receives this file too but with the platform secrets above
# (FERNET key, JWT secret, Postgres/SMTP/first-admin passwords) blanked by the compose file.
# First admin is created on first start (leave blank to skip auto-creation):
# VIGILO_FIRST_ADMIN_EMAIL=admin@example.com
# VIGILO_FIRST_ADMIN_PASSWORD=change-me-now
# Public URL of the UI, used in email links (invites, run-complete):
# VIGILO_UI_BASE_URL=http://localhost:8081

# --- Email notifications (run reports + user invitations) -------------------
# Unset VIGILO_SMTP_HOST -> notifications are silently disabled (no-op mailer).
#
# DEV default: the bundled MailHog catches every message (no auth, no TLS).
#   Open the caught mail at  http://localhost:8025
#   docker-compose.full.yml already points the API at it:
# VIGILO_SMTP_HOST=mailhog
# VIGILO_SMTP_PORT=1025
# VIGILO_SMTP_FROM=vigilo@example.com
#
# PRODUCTION: point at a real relay; add USER/PASSWORD for authenticated SMTP
# (LOGIN) and STARTTLS to upgrade the connection (typical on port 587).
# VIGILO_SMTP_HOST=smtp.example.com
# VIGILO_SMTP_PORT=587
# VIGILO_SMTP_FROM=vigilo@example.com
# VIGILO_SMTP_USER=vigilo
# VIGILO_SMTP_PASSWORD=...
# VIGILO_SMTP_STARTTLS=true

# --- Platform runtime knobs (optional; sensible defaults in compose) --------
# VIGILO_EXECUTION_ENGINE=temporal          # temporal | docker | mock | fake
# VIGILO_DOCKER_NETWORK=vigilo_net          # network worker containers join (docker engine)
# VIGILO_DEFAULT_MAX_CONCURRENT_PIPELINES=8 # parallel agents per run (admin default; per-job override)
# VIGILO_GLOBAL_CONCURRENT_RUN_CAP=2        # max pipelines running at once

# --- Grey-box web platform (optional; docker-compose.full.yml / .api.yml) ----
# Off by default. Enable it HERE (not only on the command line, or the next plain
# `up` turns it off again) and pass the `greybox` profile on EVERY compose command,
# which starts the executor process (service greybox-worker):
#   docker compose --env-file .env --profile greybox -f deploy/docker-compose.full.yml up -d
# The grey-box agent calls the model from greybox-worker: it uses the same model
# variables as white-box above (ANTHROPIC_* / CODEX_* / LITELLM_*, VIGILO_EXECUTOR).
# Full reference: deploy/config-reference.md ("Grey-box web platform").
# VIGILO_GREYBOX_WEB_ENABLED=false         # feature flag (API and worker)
# VIGILO_GREYBOX_EXECUTOR=worker           # worker (separate process, default) | inprocess (DEV ONLY) | off
# VIGILO_GREYBOX_ALLOW_PRIVATE_TARGETS=false  # KEEP false in production: true lets users scan loopback/RFC1918
# VIGILO_GREYBOX_BLOCKED_HOSTS=            # extra always-refused hostnames, comma-separated
# VIGILO_GREYBOX_BLOCKED_ENDPOINTS=        # extra always-refused host:port, e.g. private:9200,10.0.0.5:6379
# VIGILO_GREYBOX_EGRESS_PROXIES_ENABLED=false  # opt-in forward proxies for targets behind a corporate proxy (API and worker).
#   When true: admins define them under Admin -> Egress proxies, users pick one per
#   target in the "Network path" field of the target form. Off: both are hidden.
# VIGILO_GREYBOX_MAX_ACTIVE_RUNS_PER_USER=2
# VIGILO_GREYBOX_WORKER_MAX_RUNS=2         # concurrent runs per worker process
# VIGILO_GREYBOX_LEASE_TTL_S=60            # lease expiry; an expired run is failed, never retried
# VIGILO_GREYBOX_HEARTBEAT_S=10            # lease renewal / cancel polling; keep well below the TTL
# VIGILO_API_HOST=0.0.0.0                  # MUST match the real API bind/port (same in API and worker):
# VIGILO_API_PORT=8080                     #   the platform's own endpoint is derived from them and refused as a target

# --- API hardening (optional) ------------------------------------------------
# VIGILO_TRUSTED_PROXIES=                  # CIDRs whose X-Forwarded-For is believed (compose.full sets the private ranges)
# VIGILO_DEV_MODE=false                    # LOCAL DEV ONLY: allows a weak JWT secret and serves /docs
# VIGILO_API_DOCS_ENABLED=                 # force /docs, /redoc, /openapi.json on/off (default follows DEV_MODE)
# VIGILO_HSTS_ENABLED=false                # send HSTS from the API (only when the API itself is served over https)
# VIGILO_GITLAB_ALLOWED_HOSTS=             # private-address hosts a repository URL may use (your GitLab)
# VIGILO_REPO_ALLOW_PRIVATE_HOSTS=false    # dev/test only: lift the private-range deny for repository hosts

# --- Production TLS deployment (docker-compose.full.yml + Traefik) -----------
# Traefik terminates TLS and is the ONLY service with published ports (80 -> 443
# redirect, 443). The UI is the sole public router; API / Postgres / Temporal /
# MailHog stay internal on the Docker network (the UI's nginx proxies /api).
# Public UI hostname — REQUIRED to bring up the full stack:
# VIGILO_HOSTNAME=vigilo.example.com
#
# Certificates are issued over ACME (HTTP-01 challenge on :80, so the CA must
# reach this host on port 80 at VIGILO_HOSTNAME).
# ACME_EMAIL must be a REAL address — Let's Encrypt rejects @example.com.
# ACME_EMAIL=you@your-domain.example
# ACME_CASERVER defaults to Let's Encrypt. Set it only to use another CA, e.g.
# an internal/corporate ACME server:
# ACME_CASERVER=https://acme.your-internal-ca.example/acme/directory
#
# Email links default to https://$VIGILO_HOSTNAME; override if needed:
# VIGILO_UI_BASE_URL=https://vigilo.example.com

# --- Running WITHOUT Traefik / without TLS ----------------------------------
# Traefik is optional. Layer deploy/docker-compose.plain.yml on top of the full
# stack to skip it and publish the UI directly on a host port instead:
#   docker compose --env-file .env -f deploy/docker-compose.full.yml \
#       -f deploy/docker-compose.plain.yml up --build -d
# VIGILO_HTTP_PORT=8080            # UI at http://localhost:8080
# VIGILO_HTTP_PORT=127.0.0.1:8080  # loopback only — use when your own proxy fronts it
# Terminating TLS in your own proxy? Also set VIGILO_UI_BASE_URL above to the
# public URL, or email links will point at the wrong address.
# See "Deployment options" in the README.

# --- Per-run secrets (GitLab token for patch delivery, cookie for authenticated tests)
# Never written to disk and never placed in Temporal workflow input: the API stores them
# encrypted per run, workers redeem them just in time over an INTERNAL listener
# (VIGILO_INTERNAL_PORT, not published and not proxied by the UI).
# VIGILO_INTERNAL_PORT=8081                       # API: internal redemption listener
# VIGILO_INTERNAL_API_URL=http://api:8081         # workers (and docker-engine containers) call this
# VIGILO_SECRET_MAX_AGE_HOURS=168                 # a run's secret record expires after this
# VIGILO_REDEEM_MAX_PER_MINUTE=60                 # redemption attempts per run per minute
