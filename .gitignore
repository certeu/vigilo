.env
.venv/
__pycache__/
*.pyc
reports/
repositories/
# docs/reviews/ holds scratch inventory/audit notes (not shipped)
docs/reviews/
state.json
.idea/
*.egg-info/
repo/
.DS_Store
.target-repo/
.vigilo/
.vigilo-dir
.worktrees/

# Personal scan configs. These hold real target hostnames, logins, session
# cookies and API keys, so the rule is deny-by-default: ignore everything under
# configs/ and re-allow only the committed templates and *-example.yaml files.
configs/*
configs/*/
!configs/*-example.yaml
!configs/example-config.yaml
!configs/*.template.toml
!configs/*.template.json
CLAUDE.md

# ── Secrets & environment (never commit) ───────────────────────────
# `.env` is ignored above; also cover per-env / per-service variants.
# `env.sample` is the safe, committed template (does not match these).
.env.*
*.env

# ── Key / certificate material (defensive — nothing here should ship) ──
# certs/ is where you drop an internal CA chain to bind-mount into the worker.
certs/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
known_hosts

# ── Python caches / coverage ───────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Local datastores, uploads & runtime data ───────────────────────
# Dev SQLite DBs (prod uses Postgres in a volume), local data/upload dirs, logs.
*.db
*.sqlite
*.sqlite3
data/
uploads/
pgdata/
postgres-data/
temporal-data/
*.log

# ── Node (root-level; web/ has its own .gitignore too) ─────────────
node_modules/
dist/
build/

# ── Editor / tooling / agent configs ───────────────────────────────
.vscode/
.vscode
.idea
.mcp.json
.claude/

# ── Stray local shell/env files (leak from dev environment) ────────
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc

# Internal design / planning / analysis docs — not shipped in the public repo.
# (docs/images/ is kept: the README embeds it. docs/EC/ is kept: IP-clearance SBOM.)
docs/plans/
docs/improvements/
docs/superpowers/
docs/offsec-v1-fp-analysis.md
docs/architecture/
docs/reference/
docs/research/
docs/*.pdf

# Third-party benchmark corpora checked out locally (cybench, cybergym, …).
# Gigabytes of other people's code with their own licences — never commit.
vendor/

# Personal working notes.
notes.md
git-dual-remote.md

# Pipeline-testing prompt fixtures — internal fast-path, not shipped publicly.
prompts/pipeline-testing/

# Other local AI-assistant / editor / tool folders
.cursor/
.continue/
.windsurf/
.aider*
